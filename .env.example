# 로컬: 이 파일을 .local/.env 로 복사해서 값을 채운다(.local 은 Dropbox 동기화 제외 폴더).
# 호스팅(Vercel 등): 같은 이름으로 환경 변수에 넣는다.

# ── MongoDB (Atlas → Connect → Drivers → Node.js 주소) ──
# 비워 두면 로컬 파일 저장소(.local/dev-db)로 동작한다 — 시험용. 운영은 반드시 MongoDB.
MONGODB_URI=
MONGODB_DB=yogico_budget

# ── onlineData MCP (매출 실적) ──
# onlineData MCP 서버(cloudtype)의 MCP_TOKENS 에 이 앱용 항목을 추가하고 같은 토큰을 넣는다.
#   cloudtype 쪽 예: MCP_TOKENS=…,yogico-budget:<24자 이상 무작위>:read
ONLINEDATA_MCP_URL=https://port-0-yogibo-onmcp-lzgmwhc4d9883c97.sel4.cloudtype.app/mcp
ONLINEDATA_MCP_TOKEN=
# 실적 캐시 시간(시간 단위, 기본 3) — 지난 연도는 24시간
# ACTUALS_CACHE_HOURS=3

# ── 예산 연도 (기본 2027) ──
# BUDGET_YEAR=2027

# ── 로그인 ──
# 로그인 쿠키 서명 키(32자 이상 무작위). 운영에서 없으면 서버가 시작하지 않는다. 바꾸면 모두 다시 로그인.
SESSION_SECRET=
# 모든 계정의 처음 비밀번호(기본 1234) — 계정이 처음 만들어질 때만 쓰인다. 이후엔 계정 관리 화면에서 변경.
# 경영지원 비밀번호를 잊었으면: npm run admin:reset-password
# INITIAL_PASSWORD=1234

# 첨부파일 1개 최대 크기(MB, 기본 10). Vercel 은 요청 본문 4.5MB 제한이 있다.
# MAX_ATTACHMENT_MB=10

# 로컬 마스터: 1 이면 이 PC 개발 서버(npm run dev, localhost)는 로그인 없이 마스터(경영지원 권한 전체)로 열린다.
# 개발 모드 + localhost 에서만 동작하고 배포(production·Vercel)에서는 무시된다. 배포 서버 환경 변수에는 넣지 말 것.
# LOCAL_MASTER=1
